# Nim build artifacts
nimcache/
nimblecache/
nimbledeps/
bin/
*.exe
*.dll
*.so
*.dylib

# Compiled binaries (extensionless executables)
## Test binaries (t* or test, no extension)
tests/t[a-z_]*
tests/test
!tests/t*.nim
!tests/test.nim
## Nested test binaries
tests/**/[a-z_]*/
!tests/**/*.nim
!tests/**/.gitkeep
## Debug binaries and symbols
tests/debug_*
**/*.dSYM/
## Source binaries
src/[a-z_]*
!src/*.nim
!src/**/*.nim
## Example binaries
examples/[a-z_]*
!examples/*.nim
examples/**/[a-z_]*
!examples/**/*.nim

## Allow committed fixture/data files (preventive whitelist for v0.7+)
## NOTE: the bare `!tests/fixtures/` line re-includes the directory itself,
## which is required: git's gitignore rules forbid re-including a file if a
## parent directory was excluded by a prior pattern. Without this line the
## `!tests/fixtures/**` content rule would have no effect.
!tests/fixtures/
!tests/fixtures/**
!src/typestates/**/*.md
!src/typestates/**/*.yaml
!src/typestates/**/*.yml
!src/typestates/**/*.toml
!src/typestates/**/*.json

# Generated docs
htmldocs/
docs/api/
site/

# IDE/editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python
.venv/
__pycache__/

# Claude planning documents (ephemeral)
docs/plans/
logs/
deps/
nimble.paths
