# Polyform standard ignore patterns
nimcache/
*.exe
*.out
*.dll
*.so
*.dylib
nimblecache/
.nimble/
htmldocs/
site/
.DS_Store
.idea/
.vscode/
*.swp
*.swo
justfile.local

# Nim build artifacts & binaries
nimbledeps/
bin/

# Compiled binaries (extensionless executables)
## Test binaries (t* or test, no extension)
tests/t[a-z_]*
tests/test
!tests/t*.nim
!tests/test.nim
## Nested test binaries
tests/should_compile/*/[a-z_]*
tests/should_fail/*/[a-z_]*
tests/should_warn/*/[a-z_]*
!tests/should_compile/**/*.nim
!tests/should_fail/**/*.nim
!tests/should_warn/**/*.nim
!tests/**/.gitkeep
## Debug binaries and symbols
tests/debug_*
**/*.dSYM/
## Source binaries
src/[a-z_]*
!src/typestates/
!src/*.nim
!src/**/*.nim
## Example binaries
examples/[a-z_]*
!examples/*.nim
examples/**/[a-z_]*
!examples/**/*.nim

## Allow committed fixture/data files
!tests/fixtures/
!tests/fixtures/**
!src/typestates/**/*.md
!src/typestates/**/*.yaml
!src/typestates/**/*.yml
!src/typestates/**/*.toml
!src/typestates/**/*.json

# Generated docs
docs/api/

# OS
Thumbs.db

# Python
.venv/
__pycache__/

# Ephemeral planning documents
docs/plans/
logs/
deps/
nimble.paths
